<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Top Bar: Connection & Quick Controls -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="@color/card_bg"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/ev_cyan"
                android:textStyle="bold"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/tvBleStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_disconnected"
                android:textColor="@color/ev_red"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBleAction"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_connect"
            android:textSize="12sp"
            android:backgroundTint="@color/card_stroke"
            android:textColor="@color/text_white" />
    </LinearLayout>

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_bg"
        app:itemIconTint="@color/ev_cyan"
        app:itemTextColor="@color/text_white"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Content Container for Tabs -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <!-- TAB 1: COCKPIT / DASHBOARD -->
        <ScrollView
            android:id="@+id/viewCockpit"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Tín hiệu Đèn & Xi-nhan Realtime -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/indicatorTurnLeft"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:gravity="center"
                        android:text="◀"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_white"
                        android:background="@drawable/bg_signal_off" />

                    <View
                        android:layout_width="20dp"
                        android:layout_height="1dp" />

                    <TextView
                        android:id="@+id/indicatorHighBeam"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:gravity="center"
                        android:text="D"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_white"
                        android:background="@drawable/bg_signal_off" />

                    <View
                        android:layout_width="20dp"
                        android:layout_height="1dp" />

                    <TextView
                        android:id="@+id/indicatorTurnRight"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:gravity="center"
                        android:text="▶"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_white"
                        android:background="@drawable/bg_signal_off" />
                </LinearLayout>

                <!-- Speed & Gear Display Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="20dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/tvGear"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="P"
                        android:textColor="@color/ev_cyan"
                        android:textStyle="bold"
                        android:textSize="32sp" />

                    <TextView
                        android:id="@+id/tvSpeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.0"
                        android:textColor="@color/text_white"
                        android:textStyle="bold"
                        android:textSize="64sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/speed_unit"
                        android:textColor="@color/text_gray"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Power & Battery Pack Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Dung lượng Pin"
                            android:textColor="@color/text_gray"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvSoc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textStyle="bold"
                            android:textColor="@color/ev_green"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/pbSoc"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="12dp"
                        android:max="100"
                        android:progress="0"
                        android:progressTint="@color/ev_green" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Điện áp (V)"
                                android:textColor="@color/text_gray"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvVoltage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0.0 V"
                                android:textColor="@color/text_white"
                                android:textStyle="bold"
                                android:textSize="16sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Dòng xả (A)"
                                android:textColor="@color/text_gray"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvCurrent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0.0 A"
                                android:textColor="@color/text_white"
                                android:textStyle="bold"
                                android:textSize="16sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Công suất"
                                android:textColor="@color/text_gray"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvPower"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0.00 kW"
                                android:textColor="@color/ev_cyan"
                                android:textStyle="bold"
                                android:textSize="16sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Temperature & Fault Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvMotorTemp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Nhiệt động cơ: 0°C"
                            android:textColor="@color/text_gray"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvControllerTemp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Nhiệt IC Votol: 0°C"
                            android:textColor="@color/text_gray"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvVotolError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Trạng thái xe: BÌNH THƯỜNG"
                        android:textColor="@color/ev_green"
                        android:textStyle="bold"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Votol UART Live Diagnostics Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CHẨN ĐOÁN CỔNG UART VOTOL (KIỂM TRA TÍN HIỆU)"
                        android:textColor="@color/ev_cyan"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvUartStats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="TX Đã gửi: 0 Bytes | RX Đã nhận: 0 Bytes"
                        android:textColor="@color/text_white"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvUartBaud"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Baud: 9600 bps | Chân: Chuẩn (RX18/TX17)"
                        android:textColor="@color/text_gray"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvUartHex"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Chuỗi Hex nhận gần nhất: --"
                        android:textColor="@color/ev_green"
                        android:textStyle="bold"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnVotolPoll"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="11sp"
                            android:text="GỬI SHOW" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnToggleBaud"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:textSize="11sp"
                            android:text="ĐỔI BAUD" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSwapPins"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:textSize="11sp"
                            android:text="ĐẢO CHÂN" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- TAB 2: BMS 32 CELL MONITOR -->
        <LinearLayout
            android:id="@+id/viewBms"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bms_title"
                android:textColor="@color/ev_cyan"
                android:textStyle="bold"
                android:textSize="15sp"
                android:layout_marginBottom="8dp" />

            <!-- BMS Protocol Selection Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GIAO THỨC KẾT NỐI PIN (BMS)"
                    android:textColor="@color/ev_cyan"
                    android:textStyle="bold"
                    android:textSize="13sp" />

                <RadioGroup
                    android:id="@+id/rgBmsProtocol"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp">

                    <RadioButton
                        android:id="@+id/rbBmsBle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Bluetooth BLE (Mặc định - Không lo nhiễu)"
                        android:textColor="@color/text_white"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rbBmsCan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Mạng CAN Bus (250 kbps - Transceiver)"
                        android:textColor="@color/text_white"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rbBmsUart"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Dây UART (Chân chờ GPIO 16 RX / 15 TX)"
                        android:textColor="@color/text_white"
                        android:textSize="12sp" />
                </RadioGroup>

                <TextView
                    android:id="@+id/tvBmsProtocolDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Khuyên dùng: Kết nối BLE không dây giúp cách ly hoàn toàn điện áp cao của pack pin với ESP32."
                    android:textColor="@color/text_gray"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- BMS Summary Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tvBmsSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dung lượng: 0% | Tổng: 0.0V | Dòng: 0.0A"
                    android:textColor="@color/text_white"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvBmsDelta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chênh lệch Delta: 0 mV"
                    android:textColor="@color/ev_green"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvBmsMinMax"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Min: #0 (0mV) | Max: #0 (0mV)"
                    android:textColor="@color/text_gray"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/tvBmsTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nhiệt độ Pin: T1: 0°C | T2: 0°C"
                    android:textColor="@color/text_gray"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvBmsCells"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRefreshBms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_refresh_bms"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- TAB 3: VEHICLE SETTINGS (NVS FLASH) -->
        <ScrollView
            android:id="@+id/viewSettings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_title"
                    android:textColor="@color/ev_cyan"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="12dp" />

                <!-- Đường kính lốp -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_tire_desc"
                    android:textColor="@color/text_gray"
                    android:textSize="13sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTireSize"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:text="472" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Số cặp cực động cơ -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_poles_desc"
                    android:textColor="@color/text_gray"
                    android:textSize="13sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPolePairs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:text="5" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Giới hạn dòng Bus (A) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_bus_limit"
                    android:textColor="@color/text_gray"
                    android:textSize="13sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBusCurrent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:text="150" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Giới hạn dòng Pha (A) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_phase_limit"
                    android:textColor="@color/text_gray"
                    android:textSize="13sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPhaseCurrent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:text="350" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Phanh tái sinh Regen -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_regen"
                    android:textColor="@color/text_gray"
                    android:textSize="13sp" />

                <RadioGroup
                    android:id="@+id/rgRegen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <RadioButton
                        android:id="@+id/rbRegen0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tắt"
                        android:textColor="@color/text_white" />

                    <RadioButton
                        android:id="@+id/rbRegen1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nhẹ"
                        android:checked="true"
                        android:textColor="@color/text_white" />

                    <RadioButton
                        android:id="@+id/rbRegen2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vừa"
                        android:textColor="@color/text_white" />

                    <RadioButton
                        android:id="@+id/rbRegen3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mạnh"
                        android:textColor="@color/text_white" />
                </RadioGroup>

                <!-- Chế độ lái xe -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_drive_mode"
                    android:textColor="@color/text_gray"
                    android:textSize="13sp" />

                <RadioGroup
                    android:id="@+id/rgDriveMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <RadioButton
                        android:id="@+id/rbModeEco"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Eco"
                        android:textColor="@color/text_white" />

                    <RadioButton
                        android:id="@+id/rbModeNormal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Normal"
                        android:checked="true"
                        android:textColor="@color/text_white" />

                    <RadioButton
                        android:id="@+id/rbModeSport"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sport"
                        android:textColor="@color/text_white" />
                </RadioGroup>

                <!-- Nút Lưu NVS Flash -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveSettings"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="@string/btn_save_settings"
                    android:backgroundTint="@color/ev_cyan"
                    android:textColor="@color/bg_dark"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:layout_marginBottom="24dp" />
            </LinearLayout>
        </ScrollView>

